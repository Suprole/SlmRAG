# Example environment variables for Hugging Face Spaces deployment
# Copy this file to .env and modify as needed

# Set to true when running on Hugging Face Spaces
SPACE_ID=your-space-name

# Model configuration
MODEL_NAME=tinyswallow-1.5b-instruct-q5_k_m.gguf

# Embedding model
EMBEDDING_MODEL=pkshatech/GLuCoSE-base-ja-v2
# Hugging Face Spaces用のDockerfile
FROM python:3.10-slim

WORKDIR /app

# ビルドに必要なツールをインストール
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# requirements.txtをコンテナ内に直接作成
RUN pip install --no-cache-dir huggingface_hub langchain==0.0.267 faiss-cpu==1.7.4 \
    sentence-transformers==2.2.2 fastapi==0.103.1 uvicorn==0.23.2 \
    python-multipart==0.0.6 llama-cpp-python==0.1.81 pypdf==3.15.1 \
    pydantic==1.10.12 python-dotenv==1.0.0 tiktoken==0.5.1

# モデルとデータ用のディレクトリを作成
RUN mkdir -p /app/models /app/data/db /app/data/faiss /app/data/markdown

# mainアプリケーションファイルを作成
COPY <<-'EOL' /app/main.py
from fastapi import FastAPI, File, UploadFile, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
import uvicorn
import os

app = FastAPI()

# CORS設定
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/api/health")
async def health_check():
    return {"status": "ok"}

@app.get("/")
async def root():
    return {"message": "RAG Chat API is running"}

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 7860))
    uvicorn.run("main:app", host="0.0.0.0", port=port)
EOL

# 環境変数でHTTPタイムアウトを延長
ENV HF_HUB_DISABLE_PROGRESS_BARS=1 \
    HF_HUB_HTTP_TIMEOUT=300 \
    HF_HUB_ENABLE_HF_TRANSFER=1

# モデルファイルが存在しない場合はHugging Faceからダウンロード（リトライ付き）
RUN python - <<'PY'
import time, sys
from huggingface_hub import hf_hub_download
model_repo = 'SakanaAI/TinySwallow-1.5B-Instruct-GGUF'
model_file = 'tinyswallow-1.5b-instruct-q8_0.gguf'
for attempt in range(5):
    try:
        hf_hub_download(model_repo, model_file, local_dir='/app/models', resume_download=True)
        print('Model downloaded successfully')
        sys.exit(0)
    except Exception as e:
        print(f'Attempt {attempt+1}/5 failed: {e}', flush=True)
        time.sleep(30)
print('Failed to download model after 5 attempts', flush=True)
sys.exit(1)
PY

# Hugging Face Spaces用のポート設定
ENV PORT=7860
EXPOSE 7860

# アプリケーションを実行
CMD ["python", "main.py"] 